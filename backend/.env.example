# VeyaCare 跨境 AI 客服 Agent — 环境配置
# =========================================
# 复制为 .env 后填写。.env 已在 .gitignore 中，不会提交。
# 注意：本文件必须用 UTF-8 编码保存（Windows 默认 GBK 会导致中文注释乱码）。

# ---------- 应用 ----------
APP_NAME=VeyaCare
DEBUG=true
# 允许跨域的前端地址，多个用逗号分隔
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- 数据库 ----------
# 本地默认 SQLite；生产可换 postgresql+asyncpg://user:pass@host:5432/db
DATABASE_URL=sqlite+aiosqlite:///./vejacare.db

# ---------- LLM（OpenAI 兼容接口）----------
# 可选值：openai | deepseek | qwen | ollama | mock
#   mock = 离线演示模式，不调用任何外部 API，返回确定性话术，用于无 key 时跑通全链路与单测
LLM_PROVIDER=mock

# 下面三项在 LLM_PROVIDER=mock 时会被忽略
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# 生成用的模型
LLM_MODEL=deepseek-chat
# 分类/评估用的模型（要求快且稳），留空则复用 LLM_MODEL
LLM_CLASSIFIER_MODEL=

# 分类任务用 0 温度保证稳定，生成任务给一点温度让措辞自然
LLM_TEMPERATURE_CLASSIFY=0.0
LLM_TEMPERATURE_GENERATE=0.3

# ---------- Embedding ----------
# 可选值：openai | dashscope | qwen | local | hashing
#   hashing = 无需网络的确定性哈希向量，仅供离线测试，**不具备语义检索能力**
EMBEDDING_PROVIDER=hashing
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v4
# 留空则首次调用时自动探测真实维度
EMBEDDING_DIM=

# ---------- 向量库 ----------
# QDRANT_URL 留空 → 自动降级为进程内本地向量库（无需 Docker），适合本地开发
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=vejacare_kb

# ---------- 检索参数 ----------
RETRIEVE_TOP_K=20
RERANK_TOP_N=5
# RRF 融合常数，论文推荐 60
RRF_K=60
CHUNK_SIZE=420
CHUNK_OVERLAP=80

# ---------- Reranker ----------
# 可选值：none | dashscope | cohere | local
#   none = 只用 RRF 融合排序（混合检索本身已足够能打），无需额外模型
RERANK_PROVIDER=none
RERANK_BASE_URL=https://dashscope.aliyuncs.com/api/v1
RERANK_API_KEY=
RERANK_MODEL=gte-rerank-v2

# ---------- 转人工策略 ----------
# 同一问题连续 N 轮未解决 → 转人工
ESCALATION_MAX_UNRESOLVED_TURNS=2
# 用户连续 N 次表达不满 → 转人工
ESCALATION_MAX_DISSATISFACTION=2
