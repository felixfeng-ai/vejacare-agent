{
  "name": "cs-agent-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "VeyaCare 跨境 AI 客服 Agent — 前端（React + Vite + TypeScript）",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.node.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "check:reducer": "esbuild checks/reducer.contract.ts --bundle --format=esm --platform=node --outfile=.check/reducer.mjs --log-level=warning && node .check/reducer.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.6.3",
    "vite": "^6.0.7"
  }
}
